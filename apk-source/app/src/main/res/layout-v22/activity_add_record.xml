<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#afff02"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:measureWithLargestChild="false"
    android:backgroundTint="#afff02">
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="30dp">
            <EditText
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="#ff6600"
                android:gravity="center_vertical"
                android:id="@+id/siteid_edittext"
                android:background="#a4fe7a"
                android:layout_width="130dp"
                android:layout_height="match_parent"
                android:hint="@string/enter_site_id"
                android:editable="false"
                android:backgroundTint="#a4fe7a">
                <requestFocus/>
            </EditText>
            <TextView
                android:textSize="25dp"
                android:textStyle="bold"
                android:textColor="#ff6600"
                android:gravity="center"
                android:id="@+id/textView5"
                android:background="#a4fe7a"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_column="1"
                android:backgroundTint="#a4fe7a"/>
            <EditText
                android:textSize="14dp"
                android:textColor="#ff6600"
                android:gravity="center"
                android:id="@+id/sitename_edittext"
                android:background="#a4fe7a"
                android:layout_width="235dp"
                android:layout_height="match_parent"
                android:layout_column="2"
                android:hint="@string/enter_site_name"
                android:minLines="1"
                android:editable="false"
                android:backgroundTint="#a4fe7a"/>
        </TableRow>
    </TableLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:background="#c8fae2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#c8fae2">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:id="@+id/textView3"
                android:background="#a4fe7a"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Observations du:  "
                android:backgroundTint="#a4fe7a"/>
            <EditText
                android:enabled="true"
                android:textColor="#000000"
                android:gravity="center"
                android:id="@+id/date_edittext"
                android:background="#a4fe7a"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/dates"
                android:ems="10"
                android:editable="false"
                android:onClick="onClick"
                android:backgroundTint="#a4fe7a"/>
        </LinearLayout>
    </LinearLayout>
    <EditText
        android:textSize="15dp"
        android:textColor="#000000"
        android:gravity="top"
        android:id="@+id/comment_edittext"
        android:background="#dbffbc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:hint="@string/enter_comments"
        android:inputType="textMultiLine"
        android:backgroundTint="#dbffbc"
        android:scrollIndicators="right"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:id="@+id/add_record"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/add_record"/>
    </LinearLayout>
</LinearLayout>
