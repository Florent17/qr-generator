<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TableLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12dp"
            android:textStyle="italic"
            android:textColor="#002208"
            android:id="@+id/textView"
            android:background="#fbefbd"
            android:padding="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ajout du 1er Site Pour Comparaison de Localisation"
            android:textAlignment="center"
            android:backgroundTint="#fbefbd"/>
        <TableRow
            android:background="#107600"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="#107600">
            <TextView
                android:textSize="11dp"
                android:textStyle="italic|bold"
                android:textColor="#002208"
                android:background="#52fc03"
                android:padding="2dp"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_column="11"
                android:text="Entrez le Site Name / ID en dessous"
                android:textAlignment="center"
                android:backgroundTint="#07fd17"/>
            <TextView
                android:id="@+id/textView3"
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:layout_column="15"/>
        </TableRow>
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TableRow
            android:background="#107600"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="#107600">
            <EditText
                android:enabled="true"
                android:textStyle="italic|bold"
                android:textColor="#023b0d"
                android:id="@+id/myFilter"
                android:background="#c6fcbe"
                android:layout_width="230dp"
                android:layout_height="30dp"
                android:layout_column="11"
                android:hint=" "
                android:ems="10"
                android:singleLine="true"
                android:autoText="false"
                android:backgroundTint="#c6fcbe">
                <requestFocus/>
            </EditText>
            <ToggleButton
                android:enabled="true"
                android:textSize="6dp"
                android:layout_gravity="center"
                android:id="@+id/toggleButton"
                android:layout_width="85dp"
                android:layout_height="35dp"
                android:checked="false"
                android:textOn="Check by Site ID"
                android:textOff="Check by Site Name"
                android:layout_column="12"
                android:text="On For ID"
                android:nestedScrollingEnabled="false"/>
        </TableRow>
    </TableLayout>
    <ListView
        android:id="@+id/listView1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
