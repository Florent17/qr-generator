<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#f5f4f4"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="1"
    android:backgroundTint="#f5f4f4">
    <TableLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15dp"
            android:textStyle="italic"
            android:textColor="#002208"
            android:id="@+id/textView"
            android:background="#fbefbd"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Localiser les Sites Ci-dessous"
            android:textAlignment="center"
            android:backgroundTint="#fbefbd"/>
    </TableLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:background="#107600"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:backgroundTint="#107600"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="#07fd17"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#07fd17">
        <TextView
            android:textSize="20dp"
            android:textStyle="italic"
            android:textColor="#000000"
            android:id="@+id/SiteUn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1er Site Choisis:"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textSize="15dp"
            android:textColor="#000000"
            android:id="@+id/editText"
            android:background="#07fd17"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_column="3"
            android:editable="false"
            android:layout_weight="1"
            android:backgroundTint="#07fd17"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="#107600"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:backgroundTint="#107600"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="#07fd17"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#07fd17">
        <TextView
            android:textSize="20dp"
            android:textStyle="italic"
            android:textColor="#000000"
            android:id="@+id/SiteDeux"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2e Site Choisis:"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textSize="15dp"
            android:textColor="#000000"
            android:id="@+id/editText2"
            android:background="#07fd17"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_column="3"
            android:editable="false"
            android:layout_weight="1"
            android:backgroundTint="#07fd17"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="#107600"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:backgroundTint="#107600"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="#07fd17"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#07fd17">
        <TextView
            android:textSize="20dp"
            android:textStyle="italic"
            android:textColor="#000000"
            android:id="@+id/SiteTrois"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3e Site Choisis:"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textSize="15dp"
            android:textColor="#000000"
            android:id="@+id/editText3"
            android:background="#07fd17"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_column="3"
            android:editable="false"
            android:layout_weight="1"
            android:backgroundTint="#07fd17"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="#107600"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:backgroundTint="#107600"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/localiser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Localiser"/>
        <Button
            android:id="@+id/btnannuler"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Annuler"/>
    </LinearLayout>
</LinearLayout>
