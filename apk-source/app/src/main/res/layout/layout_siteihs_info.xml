<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#afff02"
    android:padding="6dp"
    android:focusableInTouchMode="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textSize="15dp"
        android:textColor="#000000"
        android:id="@+id/textView1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textSize="11dp"
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="IHS Engineer: "
        android:layout_below="@+id/textView1"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="false"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#000000"
        android:id="@+id/IHSIng"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        android:singleLine="true"
        android:layout_toRightOf="@+id/textView7"
        android:layout_alignBaseline="@+id/textView7"
        android:layout_alignBottom="@+id/textView7"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="italic|bold"
        android:textColor="#000000"
        android:id="@+id/Site_ID_View"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="IHS_LGN_999O"
        android:layout_alignBaseline="@+id/textView1"
        android:layout_alignTop="@+id/textView1"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:id="@+id/SiteName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        android:singleLine="true"
        android:layout_alignBottom="@+id/Site_ID_View"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="#ff7300"
        android:id="@+id/All_Prio_Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        android:singleLine="true"
        android:layout_alignBottom="@+id/textView7"
        android:textAlignment="textEnd"
        android:layout_toEndOf="@+id/IHSIng"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
