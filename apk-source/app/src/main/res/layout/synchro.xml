<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/textView2"
        android:layout_centerInParent="true"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="#78ff7f"
        android:gravity="center_horizontal"
        android:id="@+id/textView2"
        android:background="#02830a"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Patientez Quelques Secondes ..."
        android:textAlignment="gravity"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#050e00"
        android:id="@+id/textView3"
        android:background="#62ff00"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Mise à Jour en Cours ..."
        android:layout_below="@+id/imageView3"
        android:textAlignment="center"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/textView3"
        android:layout_toStartOf="@+id/Pourcentage"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:id="@+id/Pourcentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:hint="%"
        android:layout_below="@+id/textView3"
        android:layout_centerInParent="true"
        android:textAlignment="center"/>
</RelativeLayout>
