<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#873cff27"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textStyle="bold"
        android:textColor="#0a4f04"
        android:id="@+id/Site_ID_View"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Informations relative au site"
        android:singleLine="true"
        android:layout_alignParentTop="true"
        android:textAlignment="center"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textStyle="bold"
        android:textColor="#0a4f04"
        android:id="@+id/Region_View"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:text="Région"
        android:singleLine="true"
        android:layout_below="@+id/Site_ID_View"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="#0a4f04"
        android:id="@+id/RM_View"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="2dp"
        android:text="Regional Manager"
        android:singleLine="true"
        android:layout_below="@+id/Region_View"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="#0a4f04"
        android:id="@+id/IHS_Eng_View"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:text="IHS Engineer"
        android:singleLine="true"
        android:layout_below="@+id/RM_View"
        android:layout_toStartOf="@+id/IHS_SBD_imageView"
        android:layout_alignEnd="@+id/IHS_SBD_imageView"
        android:layout_alignParentStart="true"/>
    <include
        android:id="@+id/include"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/IHS_Eng_View"
        android:layout_centerHorizontal="true"
        android:layout_alignParentEnd="false"
        layout="@layout/table_view_operator"/>
    <fragment
        android:name="com.google.android.gms.maps.MapFragment"
        android:id="@+id/map_fragm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="5dp"
        android:layout_marginBottom="70dp"
        android:layout_below="@+id/include"
        android:layout_centerHorizontal="true"
        class="com.google.android.gms.maps.SupportMapFragment"/>
    <ImageView
        android:id="@+id/IHS_SBD_imageView"
        android:layout_width="55dp"
        android:layout_height="25dp"
        android:layout_marginRight="5dp"
        android:layout_below="@+id/Site_ID_View"
        android:layout_alignParentRight="false"
        android:layout_alignParentEnd="true"/>
    <Button
        android:textSize="12dp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:id="@+id/Retour_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_column="13"
        android:text="Retour"
        android:layout_alignTop="@+id/Comm_btn"
        android:onClick="onClick"
        android:layout_alignEnd="@+id/IHS_SBD_imageView"/>
    <Button
        android:textSize="12dp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:id="@+id/CMS_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_column="13"
        android:text="CMS"
        android:layout_alignParentBottom="true"
        android:onClick="onClick"
        android:layout_alignStart="@+id/RM_View"/>
    <Button
        android:textSize="12dp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:id="@+id/Comm_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_column="13"
        android:text="Comment"
        android:layout_alignTop="@+id/CMS_btn"
        android:onClick="onClick"
        android:layout_toEndOf="@+id/CMS_btn"/>
    <Button
        android:textSize="12dp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:id="@+id/Autres_App_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_column="13"
        android:text="Autres"
        android:layout_alignTop="@+id/Retour_btn"
        android:onClick="onClick"
        android:layout_toStartOf="@+id/Retour_btn"/>
</RelativeLayout>
