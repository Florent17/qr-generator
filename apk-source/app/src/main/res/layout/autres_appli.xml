<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#873cff27"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textSize="25dp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:id="@+id/textView17"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Applications Dévellopées"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:textAlignment="center"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:id="@+id/Url_Pharma_Titre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Pharmacie Garde RCI"
        android:layout_below="@+id/textView17"
        android:layout_centerHorizontal="true"
        android:textIsSelectable="false"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textSize="15dp"
        android:id="@+id/Url_Pharma_Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="2dp"
        android:text="Cette application est destinée à retrouver facilement les pharmacies de garde. Le prix des médicaments et tout autres information relative à la santé. Cette application est disponible sur www.aptoide.com"
        android:layout_below="@+id/Url_Pharma_Titre"
        android:layout_centerHorizontal="true"
        android:textAlignment="center"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:id="@+id/textView21"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Conso CIE"
        android:layout_below="@+id/Url_Pharma_Text"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textSize="15dp"
        android:id="@+id/textView22"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="2dp"
        android:text="Cette application est destinée à simuler le calcul de vos factures d&apos;électricité (CIE) selon les tarif de l&apos;arrêté interministériel. Cette application est disponible sur www.aptoide.com"
        android:layout_below="@+id/textView21"
        android:layout_centerHorizontal="true"
        android:textAlignment="center"/>
    <Button
        android:id="@+id/retour_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="72dp"
        android:text="Retour"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:onClick="onClick"
        style="?android:attr/buttonStyleSmall"/>
    <com.facebook.share.widget.LikeView
        android:id="@+id/likeView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:layout_above="@+id/retour_btn"
        android:layout_centerHorizontal="true"
        android:onClick="onClick"/>
    <ImageButton
        android:id="@+id/download_Pharma_btn"
        android:background="@drawable/download_logo"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginLeft="10dp"
        android:layout_toRightOf="@+id/Url_Pharma_Titre"
        android:layout_alignTop="@+id/Url_Pharma_Titre"
        android:onClick="onClick"
        android:layout_toEndOf="@+id/Url_Pharma_Titre"/>
    <ImageButton
        android:id="@+id/Download_CIE_btn"
        android:background="@drawable/download_logo"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginLeft="10dp"
        android:layout_above="@+id/textView22"
        android:onClick="onClick"
        android:layout_toEndOf="@+id/textView21"/>
</RelativeLayout>
